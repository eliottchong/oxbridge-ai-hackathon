# Local development creates an explicitly labelled shared synthetic demo session.
# Public deployments must explicitly choose demo access or configure a workspace token.
LABRELAX_DEMO_MODE=false
LABRELAX_SESSION_SECRET=replace-with-a-long-random-secret-before-deployment
LABRELAX_ACCESS_TOKEN=replace-with-a-separate-random-workspace-token
# File-backed SQLite. Mount persistent storage for a hosted Node deployment.
LABRELAX_DB_PATH=.data/labrelax.sqlite
# Disable built-in temporary test stock when importing the team's final baseline.
LABRELAX_SEED_DEMO=true
# Optional real AI transcription; template transcription works without a key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional isolated ASRP race adapter (server-only credentials).
# GEMINI_API_KEY=
# AGENT_STUDIO_VERIFIER_TOKEN=
# RACE_USAGE_LOG=/absolute/private/path/gemini-usage.jsonl
# RACE_TOOL_HOSTS=superteam-agent-studio.vercel.app
